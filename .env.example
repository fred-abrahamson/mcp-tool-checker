# Copy to .env (git-ignored) and fill in. Never commit .env.

# Model keys: a paid run reads these. Only the vendors in config/models.json are needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The HTTP MCP server to snapshot. Not needed for a stdio server (--command).
MCP_URL=
# A bearer token the server accepts. Leave empty for a server without auth.
MCP_BEARER=
